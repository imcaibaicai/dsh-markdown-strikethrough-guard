{
  "name": "dsh-markdown-strikethrough-guard",
  "description": "INEFFECTIVE (kept as a pitfall analysis): every DSH client module namespace is Object.freeze'd, so a plugin cannot replace MarkdownText. Documents why lone-tilde strikethrough cannot be fixed client-side.",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "strikethrough",
    "tilde",
    "ui"
  ],
  "author": "imcaibaicai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imcaibaicai/dsh-markdown-strikethrough-guard.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "install.ps1",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
